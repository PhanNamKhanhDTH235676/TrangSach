@model TrangchuVm
@{
    var tin = new[]
    {
        ("sh", "Giữ tiền trung gian", "Chỉ chuyển cho người bán khi bạn nhận sách"),
        ("ck", "Kiểm duyệt tình trạng", "Mỗi tin đăng được rà soát trước khi hiển thị"),
        ("rf", "Hoàn tiền 48 giờ", "Nếu sách sai mô tả so với tin đăng"),
        ("ph", "Hỗ trợ 8:00 – 21:00", "Hotline và email hỗ trợ")
    };
    var hoi = new[]
    {
        ("Tiền của tôi được bảo vệ thế nào?", "Khi bạn thanh toán, tiền được giữ tại tài khoản trung gian và chỉ chuyển cho người bán sau khi bạn xác nhận đã nhận sách đúng mô tả."),
        ("Phí môi giới được tính khi nào?", "Chỉ tính khi giao dịch hoàn tất. Đăng tin hoàn toàn miễn phí."),
        ("Sách không đúng mô tả thì sao?", "Bạn có 48 giờ kể từ khi nhận hàng để khiếu nại và được hoàn tiền sau khi xác minh.")
    };
}
<div class="w">
    <section class="hero">
        <div>
            <em class="t p">Sàn môi giới sách cũ</em>
            <h1 style="margin:12px 0">Mua bán sách cũ,<br>có đơn vị bảo chứng.</h1>
            <p class="mu" style="max-width:480px">Trang Sách đứng giữa người mua và người bán: giữ tiền trung gian, kiểm duyệt tình trạng sách và hoàn tiền nếu sách không đúng mô tả.</p>
            <div class="row" style="display:flex;gap:10px;margin:20px 0">
                <a class="btn" asp-controller="Main" asp-action="Danhsach">Khám phá sách</a>
                <a class="btn o" asp-controller="Sach" asp-action="Create">Đăng bán sách</a>
            </div>
            <div class="mu">Phổ biến: @foreach (var c in Model.Theloais.Take(5)){<a style="color:var(--p);margin-right:10px" asp-controller="Main" asp-action="Danhsach" asp-route-theloai="@c.Ten">@c.Ten</a>}</div>
        </div>
        <div class="card">
            <h3 style="margin-bottom:8px">Giao dịch gần đây</h3>
            @foreach (var d in Model.GiaoDichGanDay)
            {
                <div class="ofr">@Ui.Avatar(d.Nguoimuaid, d.Nguoimua?.HoTen, 30)<div><b>@d.Sach?.Tensach</b><br><small>Mua · @Fmt.Ago(d.Ngaydat)</small></div><b style="margin-left:auto">@Fmt.Money(d.Giasach)</b></div>
            }
            @if (Model.GiaoDichGanDay.Count == 0)
            {
                <p class="mu">Chưa có giao dịch nào.</p>
            }
            <div class="g4" style="grid-template-columns:1fr 1fr 1fr;margin-top:12px">
                <div class="kp"><b>@Fmt.Num(Model.SoSach)</b><small>Đầu sách</small></div>
                <div class="kp"><b>@Fmt.Num(Model.SoThanhVien)</b><small>Thành viên</small></div>
                <div class="kp"><b>@(Model.DiemTb == null ? "—" : Fmt.Dec(Model.DiemTb.Value) + "/5")</b><small>Đánh giá</small></div>
            </div>
        </div>
    </section>

    <div class="tr">
        @foreach (var (i, a, b) in tin)
        {
            <div>@Fmt.Icon(i, 24)<div style="display:block;padding:0;border:0"><b>@a</b><br><small>@b</small></div></div>
        }
    </div>

    <section class="sec">
        <div class="sh"><h2>Danh mục sách</h2></div>
        <div class="cats">
            @foreach (var c in Model.Theloais)
            {
                <a asp-controller="Main" asp-action="Danhsach" asp-route-theloai="@c.Ten"><i>@Fmt.Icon("bk")</i><div><b>@c.Ten</b><br><small>@c.Soluong đầu sách</small></div></a>
            }
        </div>
    </section>

    <section class="sec">
        <div class="sh"><h2>Sách mới đăng</h2><a asp-controller="Main" asp-action="Danhsach">Xem tất cả</a></div>
        <div class="grid">
            @foreach (var s in Model.SachMoi)
            {
                <partial name="_BookCard" model="s" />
            }
        </div>
        @if (Model.SachMoi.Count == 0)
        {
            <div class="card mu">Chưa có sách nào đang bán.</div>
        }
    </section>

    <section class="sec">
        <div>
            <div class="sh"><h2>Biểu phí môi giới</h2></div>
            <div class="card">
                <table>
                    <tr><th>Hình thức</th><th>Phí</th></tr>
                    <tr><td>Bán sách</td><td>@Model.Phiban% giá bán (người bán)</td></tr>
                    <tr><td>Mua sách</td><td>@Model.Phimua% phí bảo vệ (người mua)</td></tr>
                    <tr><td>Đăng tin</td><td>Miễn phí</td></tr>
                </table>
            </div>
        </div>
    </section>

    <section class="sec">
        <div class="sh"><h2>Câu hỏi thường gặp</h2></div>
        @foreach (var (q, a) in hoi)
        {
            <details><summary>@q</summary><p>@a</p></details>
        }
    </section>
</div>
